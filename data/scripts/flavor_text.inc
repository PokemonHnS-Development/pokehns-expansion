@ Flavor text for interacting with various background objects

Text_Bookshelf::
	.string "Está repleto de POKéMON\n"
	.string "libros.$"

Text_NothingButPokemonBooks::
	.string "ほんだなに　ならんでいるのは\n"
	.string "ポケモンの　ほん　ばかりだ$"

Text_ATownMap::
	.string "UN MAPA DE LA CIUDAD.$"

Text_PokeMartShelf::
	.string "¡Guau!\n"
	.string "¡Cosas de POKéMON por doquier!$"

Text_DishesPlatesNeatlyLinedUp::
	.string "Los platos y fuentes están\n"
	.string "bien alineados.$"

Text_Kitchen::
	.string "¡Huele delicioso!\n"
	.string "Alguien ha estado cocinando.$"

Text_Dresser::
	.string "Es una cómoda muy bonita.\n"
	.string "Cabe muchísimas cosas.$"

Text_Snacks::
	.string "Hay un montón de snacks aquí.$"

Text_PokemartSign::
	.string "¡Todo lo que necesitas está aquí!\n"
	.string "TIENDA POKéMON$"

Text_PokecenterSign::
	.string "¡Cura a tus POKéMON!\n"
	.string "POKéMON CENTER$"

Text_Indigo_UltimateGoal::
	.string "MESETA AÑIL\p"
	.string "¡La meta final de los ENTRENADORES!\n"
	.string "Sede de la LIGA POKéMON$"

Text_Indigo_HighestAuthority::
	.string "MESETA AÑIL\p"
	.string "¡La máxima autoridad POKéMON!\n"
	.string "Sede de la LIGA POKéMON$"

Text_Food::
	.string "Debe estar lleno de todo tipo\n"
	.string "de cosas deliciosas para comer.$"

Text_Blueprints::
	.string "Es una especie de plano.\n"
	.string "Está lleno de diagramas y texto.$"

Text_Painting::
	.string "Es un dibujo lindo de un POKéMON.\n"
	.string "Parece que se siente bien.$"

Text_PowerPlantMachine::
	.string "¿Qué podrá ser esta máquina?\n"
	.string "¡Mejor no jugar con ella!$"

Text_Telephone::
	.string "Es un teléfono.\n"
	.string "Mejor no usarlo.$"

Text_Computer::
	.string "Son palabras complicadas y\n"
	.string "números que no tienen sentido...$"

Text_AdvertisingPoster::
	.string "Es un póster publicitario de\n"
	.string "todo tipo de productos.$"

Text_TastyFood::
	.string "¡Oh, huele delicioso!\n"
	.string "¡Me dará hambre de solo olerlo!$"

Text_TrashBin::
	.string "Dentro de esto...\n"
	.string "......\p"
	.string "¡No hay nada aquí!$"

Text_Cup::
	.string "Es una taza con la marca POKéMON\n"
	.string "on it.$"

Text_PolishedWindow::
	.string "La ventana está muy limpia.$"

Text_BeautifulSkyWindow::
	.string "Fuera de la ventana...\p"
	.string "El cielo se ve fantásticamente\n"
	.string "bello.$"

Text_BlinkingLights::
	.string "Luces de varios colores\nse encienden y apagan.$"

Text_NeatlyLinedUpTools::
	.string "Herramientas de todo tipo\nordenadas con esmero.$"

Text_ImpressiveMachine::
	.string "Es una máquina de algún tipo.\nSin duda es impresionante.$"

Text_VideoGame::
	.string "¡Es el videojuego más nuevo!\n¡Se ve muy divertido!$"

Text_Burglary::
	.string "Hay señales claras de un robo\n"
	.string "por aquí...$"

Text_PlayerFacingTVScreen::
	.string "¡Hay un POKéMON en la TV!\n"
	.string "Parece que se está divirtiendo.$"
