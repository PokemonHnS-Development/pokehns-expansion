@ Field notes (Birch's aide): how many rumors you've found, then a vague hint for the next.
HoennSeek_EventScript_FieldNotes::
	lock
	faceplayer
	callnative HoennSeek_FieldNotesCount @ STR_VAR_1 found, STR_VAR_2 total; VAR_RESULT = unfound
	msgbox HoennSeek_Text_FieldNotesIntro, MSGBOX_DEFAULT
	goto_if_eq VAR_RESULT, 0, HoennSeek_EventScript_FieldNotesAllFound
	msgbox HoennSeek_Text_FieldNotesNext, MSGBOX_DEFAULT
	callnative HoennSeek_FieldNotesHint @ the first unfound rumor's notes
	callstd MSGBOX_DEFAULT
	release
	end
HoennSeek_EventScript_FieldNotesAllFound::
	msgbox HoennSeek_Text_FieldNotesAllFound, MSGBOX_DEFAULT
	release
	end

