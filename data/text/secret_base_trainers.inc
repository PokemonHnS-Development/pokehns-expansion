SecretBase_Text_Trainer0Intro:
	.string "¿Ya hiciste tu BASE SECRETA?\p"
	.string "Fui aquí, allá y a todas partes\n"
	.string "antes de elegir este lugar.\p"
	.string "Ya que estás aquí, ¿te gustaría\n"
	.string "tener una batalla?$"

SecretBase_Text_Trainer0AcceptBattle:
	.string "¡Está bien!\n"
	.string "¡Aquí vamos!$"

SecretBase_Text_Trainer0DeclineBattle:
	.string "¿Eh?\n"
	.string "Oh, no puedes ahora...$"

SecretBase_Text_Trainer0Defeated::
	.string "¡Waaargh! ¡Eres muy fuerte!\n"
	.string "Que perdí... ¡Por favor, no lo digas!$"

SecretBase_Text_Trainer0PostBattle:
	.string "¿Qué te parece mi BASE SECRETA?\n"
	.string "Ven a visitarme mañana otra vez.$"

