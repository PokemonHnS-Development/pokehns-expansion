	.string "Siempre está ocupado.\p"
	.string "¡Oh! ¿Acaso estabas pensando\n"
	.string "en querer este lugar también?\p"
	.string "Te propongo algo: te doy este\n"
	.string "lugar si logras vencerme.$"

