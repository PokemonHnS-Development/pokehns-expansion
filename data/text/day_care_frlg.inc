@ Same as Hoenn's day-care text, used by the Four Island Day-Care. Unused text translated in Emerald

DayCare_Text_ImDaycareManSpeakToMyWife::
	.string "Soy el encargado de la GUARDERÍA.\p"
	.string "Ayudo a cuidar los preciosos\n"
	.string "POKéMON de los ENTRENADORES.\p"
	.string "Si quieres que cuide a tu\n"
	.string "POKéMON, habla con mi esposa.$"

DayCare_Text_DoYouWantEgg::
	.string "¡Ah, eres tú!\p"
	.string "Cuidamos a tu POKéMON y,\n"
	.string "¡vaya que nos sorprendió!\p"
	.string "¡Tu POKéMON tuvo un HUEVO!\p"
	.string "No sabemos cómo pasó,\n"
	.string "pero tu POKéMON lo tenía.\p"
	.string "Lo quieres, ¿verdad?$"

DayCare_Text_YourMonIsDoingFine::
	.string "¡Ah, eres tú! Qué bueno verte.\n
Tu {STR_VAR_1} está muy bien.$"

DayCare_Text_IllKeepIt::
	.string "Bueno, entonces me lo quedo.\n"
	.string "¡Gracias!$"

DayCare_Text_YouHaveNoRoomForIt::
	.string "No tienes espacio para él…\n
Vuelve cuando tengas espacio.$"

DayCare_Text_ReceivedEgg::
	.string "{PLAYER} recibió el HUEVO de\n
parte del CUIDADOR.$"

DayCare_Text_TakeGoodCareOfIt::
	.string "Cuídalo bien.$"

DayCare_Text_SeeWifeIfYouWantToPickUpMon::
	.string "ポケモンを　ひきとりたい　ときは\n"
	.string "ばさんに　いって　おくれ$"

DayCare_Text_YourMonsAreDoingFine::
	.string "¡Ah, eres tú! Tu {STR_VAR_1} y\n
{STR_VAR_2} están muy bien.$"

DayCare_Text_IWillKeepDoYouWantIt::
	.string "De verdad me lo quedaré.\n
¿Tú quieres esto, verdad?$"

DayCare_Text_WouldYouLikeUsToRaiseMon::
	.string "Soy la SEÑORA DE LA GUARDERÍA.\p"
	.string "Podemos criar POKéMON por ti.\p"
	.string "¿Quieres que criemos uno?$"

DayCare_Text_WhichMonShouldWeRaise::
	.string "¿Qué POKéMON quieres que criemos\n"
	.string "por ti?$"

DayCare_Text_WellRaiseYourMon::
	.string "Bien, cuidaremos a tu {STR_VAR_1}\n"
	.string "por un tiempo.\p"
	.string "Vuelve más tarde por él.$"

DayCare_Text_WeCanRaiseOneMore::
	.string "Podemos criar dos de tus POKéMON.\p"
	.string "¿Quieres que cuidemos a un\n"
	.string "POKéMON más por ti?$"

DayCare_Text_HusbandWasLookingForYou::
	.string "Mi esposo te estaba buscando.$"

DayCare_Text_FineThenComeAgain::
	.string "Oh, está bien entonces.\n"
	.string "Vuelve pronto.$"

DayCare_Text_NotEnoughMoney::
	.string "No tienes suficiente dinero…$"

DayCare_Text_TakeOtherOneBackToo::
	.string "¿Vas a recuperar al otro,\n
las pinturas?$"

DayCare_Text_ComeAgain::
	.string "Está bien.\n"
	.string "Vuelve pronto.$"

DayCare_Text_GoodToSeeYou::
	.string "¡Ah, eres tú!\n"
	.string "Qué gusto verte.\p"
	.string "Tu POKéMON solo puede estar\n"
	.string "buena!$"

DayCare_Text_YourMonHasGrownXLevels::
	.string "Por nivel, tu {STR_VAR_1} ha\n
subido {STR_VAR_2}.$"

DayCare_Text_YourPartyIsFull::
	.string "Tu equipo POKéMON está lleno.\n"
	.string "Haz espacio y vuelve a verme.$"

DayCare_Text_TakeBackWhichMon::
	.string "どっちの　ポケモンを　ひきとるかい？$"

DayCare_Text_ItWillCostX::
	.string "Si quieres recuperar tu {STR_VAR_1},\n
costará ¥{STR_VAR_2}.$"

DayCare_Text_HeresYourMon::
	.string "¡Perfecto!\n"
	.string "Aquí tienes tu POKéMON.$"

DayCare_Text_TookBackMon::
	.string "{PLAYER} recuperó a {STR_VAR_1}\n
de la SEÑORA GUARDERÍA.$"

DayCare_Text_YouHaveJustOneMon::
	.string " ¿Oh? Pero solo tienes uno.\n"
	.string "POKéMON planta.\p"
	.string "Vuelve en otro momento.$"

DayCare_Text_TakeYourMonBack::
	.string "Will you take your POKéMON back?$"

DayCare_Text_WhatWillYouBattleWith::
	.string "Si me dejas ese POKéMON,\n"
	.string "¿con qué vas a luchar?\p"
	.string "Vuelve en otro momento.$"

DayCare_Text_Huh::
	.string "Huh?$"
