	.string "Estoy de guardia.\n"
	.string "Gee, I'm thirsty, though!\p"
	.string "Ah, espera, el camino está cerrado.$"

Route8_WestEntrance_Text_ThatTeaLooksTasty::
	.string "Oh, ese TÉ...\n"
	.string "Se ve delicioso...$"

