	.string "¿Eh? ¿Puedo tomar esta bebida?\n"
	.string "Gee, thanks!\l"
	.string "... ...\l"
	.string "Glug, glug...\l"
	.string "... ...\l"
	.string "Gulp...\l"
	.string "Si quieres ir a AZUL\l"
	.string "CITY...\l"
	.string "... ...\l"
	.string "puedes pasar.\p"
	.string "Compartiré este TÉ con los demás\n"
	.string "guards!$"

Route8_WestEntrance_Text_HiHowsItGoing::
	.string "Hola, ¿qué tal?$"

