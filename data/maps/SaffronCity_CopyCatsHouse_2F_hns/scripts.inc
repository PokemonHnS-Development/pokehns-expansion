Copycat_Text_Male_1:
	.string "{PLAYER}: ¡Hola! ¿Te gustan los POKéMON?\p"
	.string "{PLAYER}: Eh, no, solo te preguntaba.\p"
	.string "{PLAYER}: ¿Eh? ¡Eres muy raro!$"

Copycat_Text_QuickMimicking:
	.string "COPYCAT: ¿Hmm? ¿Dejas de imitarme?\p"
	.string "¡Pero si es mi pasatiempo favorito!$"

Copycat_Text_Male_2:
	.string "{PLAYER}: ¡Hola! Me enteré de que\n"
	.string "perdiste tu MUÑECO POKé favorito.\p"
	.string "{PLAYER}: Si lo encuentro, ¿me darás\n"
	.string "un PASE de tren?\p"
	.string "{PLAYER}: Iré a buscarlo por ti.\p"
	.string "Crees que lo perdiste cuando fuiste\n"
	.string "a CIUDAD VERMILIAN, ¿verdad?$"

Copycat_Text_Worried:
	.string "COPYCAT: ¿Perdón?\p"
	.string "¿No debería decidir yo lo que\n"
	.string "debes hacer?\p"
	.string "Pero estoy preocupada... ¿Y si\n"
	.string "alguien lo encuentra?$"

Copycat_Text_GiveDoll:
	.string "COPYCAT: ¡Sii! ¡Es mi MUÑECA\n"
	.string "POKé de CLEFAIRY!\p"
	.string "¿Ves el rasguño donde cosieron\n"
	.string "la pierna derecha? ¡Es la prueba!$"

Copycat_Text_GivePass:
	.string "Vale. ¡Toma el PASE DEL TREN\n"
	.string "MAGNÉTICO, como prometí!$"

Copycat_Text_ExplainPass:
	.string "COPYCAT: Ese es el PASE para el\n
MAGNET TRAIN.\p
El de la compañía me lo dio\n
cuando tiraron nuestra vieja\l
casa para la ESTACIÓN.$"

Copycat_Text_Male_3:
	.string "{PLAYER}: ¡Hola! Gracias por el\n
PASE de tren!\p
{PLAYER}: ¿Perdón?\p
{PLAYER}: ¿Es tan divertido imitar\n
cada movimiento mío?$"

Copycat_Text_ItsAScream:
	.string "COPYCAT: ¡Claro que sí! ¡Es genial!$"

Copycat_Text_Dodrio1:
	.string "DODRIO: Gii giii!$"

Copycat_Text_Dodrio2:
	.string "ESPEJITO, ESPEJITO,\n
¿QUIÉN ES LA MÁS BELLA DE TODAS?$"

Copycat_Text_2FDoll:
	.string "¡Es un POKéMON raro! ¿Eh?\p"
	.string "Solo es un muñeco...$"
