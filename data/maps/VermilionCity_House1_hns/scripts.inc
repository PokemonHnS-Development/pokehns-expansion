VermilionCity_House1_hns_MapScripts::
	.byte 0

VermilionCity_House1_EventScript_Fisher::
	msgbox VermilionCity_House1_Text_FishingDude, MSGBOX_NPC
	end
VermilionCity_House1_EventScript_Photo::
	msgbox VermilionCity_House1_Text_Photo, MSGBOX_NPC
	end
VermilionCity_House1_Text_FishingDude:
	.string "אני גבר הדיג, הבכור מבין\n"
	.string "האחים הדייגים.\p"
	.string "פגשת את גורו הדיג\n"
	.string "באגם הזעם?\p"
	.string "הוא חולם לראות את המג'יקארפ\n"
	.string "הגדול ביותר בעולם.\p"
	.string "אם לא אכפת לך, תוכל להראות לו\n"
	.string "כל מג'יקארפ שתתפוס?\p"
	.string "מי יודע, אולי תתפוס את\n"
	.string "המג'יקארפ של החלומות שלו.$"

VermilionCity_House1_Text_Photo:
	.string "זו תמונה של אנשים שדגים…\p"
	.string "הם נהנים מאוד…$"
