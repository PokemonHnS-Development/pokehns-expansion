VermilionCity_House1_hns_MapScripts::
	.byte 0

VermilionCity_House1_EventScript_Fisher::
	msgbox VermilionCity_House1_Text_FishingDude, MSGBOX_NPC
	end
VermilionCity_House1_EventScript_Photo::
	msgbox VermilionCity_House1_Text_Photo, MSGBOX_NPC
	end
VermilionCity_House1_Text_FishingDude:
	.string "Soy el TIPO PESCA, el mayor\n"
	.string "de los HERMANOS PESCA.\p"
	.string "¿Ya conociste al GURÚ PESCA en el\n"
	.string "LAGO DE LA FURIA?\p"
	.string "Él sueña con ver al MAGIKARP\n"
	.string "más grande del mundo.\p"
	.string "Si no te importa, ¿podrías\n"
	.string "mostrarle los MAGIKARP que pesques?\p"
	.string "Quién sabe, tal vez pesques al\n"
	.string "MAGIKARP de sus sueños.$"

VermilionCity_House1_Text_Photo:
	.string "Es una foto de gente pescando...\p"
	.string "Se lo están pasando genial...$"
